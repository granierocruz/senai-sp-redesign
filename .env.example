# TEMPLATE DE CONFIGURAÇÃO DE AMBIENTE - NUNCA INCLUA VALORES REAIS AQUI
NODE_ENV=development
PORT=3000

# Chaves de Serviço (NUNCA EXPONHA NO CLIENTE OU REPOSITÓRIO GIT)
STITCH_API_KEY=your_google_stitch_api_key_here
SESSION_SECRET=your_32_bytes_cryptographically_secure_random_string_here

# Banco de Dados
DATABASE_URL=postgresql://user:password@localhost:5432/database_name?sslmode=require

# Limites de Taxa (Rate Limiting)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5

# CORS
CORS_ORIGIN=https://sp.senai.br
